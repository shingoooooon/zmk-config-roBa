#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer は無効化(ドライバの default -1 = 機能OFF)。
    // 以前は Win_default レイヤーを指しており、win_mode で切り替えた直後に
    // トラックボールのタイムアウト処理が同じレイヤーを無効化してしまい、
    // layer 0 に戻ってしまう原因になっていた。
    // layer 1 = Mac側のNUM、layer 4 = Win側のNUM。両方でスクロールできるようにする。

    scroll-layers = <1 4>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        l_click {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };

        r_click {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };
    };

    macros {
        mac_mode: mac_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "MAC_MODE";
        };

        win_mode: win_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 3>;
            label = "WIN_MODE";
        };

        mac_mode_2: win_mode_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 0>;
            label = "WIN_MODE_2";
        };

        // ブラウザの「戻る」(Alt + ←)。
        // &kp LA(LEFT_ARROW) だと修飾キーとキーコードが同じHIDレポートで
        // 同時に送られ、Windows側が矢印キーを先に処理して素の左矢印に
        // なってしまうことがある。Altを先に送る3段階に分けて回避する。
        // BLE経由でレポートが並び替わらないよう 30ms 確保している。

        alt_left: alt_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_LEFT";
        };

        win_mode_2: win_mode_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 3>;
            label = "WIN_MODE_2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q        &kp W      &kp E         &kp R         &kp T                                                 &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S      &kp D         &kp F         &kp G        &kp LS(LG(NUMBER_4))      &kp SEMICOLON  &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z    &kp X      &kp C         &kp V         &kp B        &kp RIGHT_GUI             &kp SQT        &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT      &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 1 SPACE  &lt 6 TAB                 &kp BACKSPACE  &lt 2 ENTER                             &mt RIGHT_GUI LG(LEFT_BRACKET)
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        NUM {
            bindings = <
&trans                      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LEFT_PARENTHESIS                      &kp RIGHT_PARENTHESIS  &kp TILDE  &kp EXCL       &kp AT_SIGN   &kp PIPE
&trans                      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LEFT_BRACKET      &trans      &trans  &kp RIGHT_BRACKET      &kp HASH   &kp DOLLAR     &kp PERCENT   &kp EQUAL
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LEFT_BRACE        &trans      &trans  &kp RIGHT_BRACE        &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp PLUS
&trans                      &trans           &trans           &trans           &trans                &trans      &trans  &trans                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOLUME_UP>;
        };

        ARROW {
            bindings = <
&kp LG(LA(ESCAPE))  &trans     &kp C_PLAY_PAUSE  &kp LG(MINUS)     &kp LG(PLUS)                      &kp LG(LA(LEFT_ARROW))  &kp LG(LA(DOWN_ARROW))  &kp LG(LA(UP_ARROW))  &kp LG(LA(RIGHT_ARROW))  &trans
&kp F12             &kp LG(L)  &trans            &kp LC(UP_ARROW)  &kp F3        &trans      &trans  &kp LEFT_ARROW          &kp DOWN_ARROW          &kp UP_ARROW          &kp RIGHT                &kp LA(LC(ENTER))
&trans              &trans     &trans            &trans            &trans        &trans      &trans  &kp LA(LC(LEFT_ARROW))  &kp LA(LC(DOWN_ARROW))  &kp LC(LA(UP_ARROW))  &kp LA(LC(RIGHT))        &trans
&trans              &trans     &trans            &kp LG(SPACE)     &trans        &trans      &trans  &none                                                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_DEC C_BRIGHTNESS_INC>;
        };

        Win_default {
            bindings = <
&mt ESC Q         &kp W         &kp E         &kp R             &kp T                                          &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A             &kp S         &kp D         &kp F             &kp G        &kp LC(LS(S))      &kp SEMICOLON  &kp H        &kp J  &kp K      &kp L       &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &kp B        &trans             &kp LS(N7)     &kp N        &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&kp LEFT_SHIFT    &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &lt 4 SPACE  &lt 6 TAB          &kp BACKSPACE  &lt 5 ENTER                                &alt_left
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        // Windows 側の数字・記号レイヤー。
        // Windows のキーボードレイアウトが日本語(106/109)のため、ZMK が送る
        // US配列のスキャンコードは JIS として解釈される。見た目のキーコード名と
        // 実際に出る文字が一致しないので、下記の対応で「出したい文字」から
        // 逆算した名前を指定している(コメントの文字が実際に出るもの)。
        //
        //   LS(N2)=" LS(N6)=& LS(N7)=' LS(N8)=( LS(N9)=)
        //   EQUAL=^ LS(EQUAL)=~ LS(MINUS)==
        //   LEFT_BRACKET=@ LS(LEFT_BRACKET)=`
        //   RIGHT_BRACKET=[ LS(RIGHT_BRACKET)={
        //   BACKSLASH=] LS(BACKSLASH)=}
        //   SEMICOLON=; LS(SEMICOLON)=+  SQT=: LS(SQT)=*
        //   INT_YEN=¥ LS(INT_YEN)=|  INT_RO=\ LS(INT_RO)=_
        //   数字と ! # $ % , . / - は US と同じ
        //
        // 数字は KP_NUMBER_* (テンキー) から N* (数字段) に変更。
        // テンキーは Windows で NumLock が OFF だとカーソル移動になり
        // 数字が打てないため。

        layer_5 {
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &kp LS(N8)                                 &kp LS(N9)         &kp LS(EQUAL)  &kp LS(N1)  &kp LEFT_BRACKET  &kp LS(INT_YEN)
&trans  &kp N4  &kp N5  &kp N6  &kp RIGHT_BRACKET      &trans      &trans  &kp BACKSLASH      &kp LS(N3)     &kp LS(N4)  &kp LS(N5)        &kp LS(MINUS)
&kp N0  &kp N1  &kp N2  &kp N3  &kp LS(RIGHT_BRACKET)  &trans      &trans  &kp LS(BACKSLASH)  &kp EQUAL      &kp LS(N6)  &kp LS(SQT)       &kp LS(SEMICOLON)
&trans  &trans  &trans  &trans  &trans                 &trans      &trans  &trans                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &kp LC(MINUS)  &kp LC(LS(SEMICOLON))                      &trans              &kp LC(LS(TAB))     &kp LC(TAB)       &trans               &trans
&trans  &trans  &trans  &kp LA(TAB)    &trans                 &trans      &trans  &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT_ARROW      &trans
&trans  &trans  &trans  &trans         &trans                 &trans      &trans  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &kp GRAVE      &trans                 &trans      &trans  &trans                                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_DEC C_BRI_INC>;
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &mac_mode  &win_mode  &mac_mode_2  &win_mode_2  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &trans       &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &trans       &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };
    };
};
