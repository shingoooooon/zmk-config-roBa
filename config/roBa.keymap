#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer は無効化(ドライバの default -1 = 機能OFF)。
    // 以前は <4> = Win_default を指しており、&to 4 で切り替えた直後に
    // トラックボールのタイムアウト処理が同じレイヤー4を無効化してしまい、
    // win_mode / win_mode_2 が layer 0 に戻る原因になっていた。
    // layer 1 = Mac側のNUM、layer 5 = Win側のNUM。両方でスクロールできるようにする。

    scroll-layers = <1 5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        l_click {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };

        r_click {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };
    };

    macros {
        mac_mode: mac_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "MAC_MODE";
        };

        win_mode: win_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 4>;
            label = "WIN_MODE";
        };

        win_mode_2: win_mode_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 4>;
            label = "WIN_MODE_2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q        &kp W      &kp E         &kp R         &kp T                                                 &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S      &kp D         &kp F         &kp G        &kp LS(LG(NUMBER_4))      &kp SEMICOLON  &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z    &kp X      &kp C         &kp V         &kp B        &kp RIGHT_GUI             &kp SQT        &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT      &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 1 SPACE  &lt 3 TAB                 &kp BACKSPACE  &lt 2 ENTER                             &mt RIGHT_GUI LG(LEFT_BRACKET)
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        NUM {
            bindings = <
&trans                      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LEFT_PARENTHESIS                      &kp RIGHT_PARENTHESIS  &kp TILDE  &kp EXCL       &kp AT_SIGN   &kp PIPE
&trans                      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LEFT_BRACKET      &trans      &trans  &kp RIGHT_BRACKET      &kp HASH   &kp DOLLAR     &kp PERCENT   &kp EQUAL
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LEFT_BRACE        &trans      &trans  &kp RIGHT_BRACE        &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp PLUS
&trans                      &trans           &trans           &trans           &trans                &trans      &trans  &trans                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOLUME_UP>;
        };

        ARROW {
            bindings = <
&kp LG(LA(ESCAPE))  &trans     &kp C_PLAY_PAUSE  &kp LG(MINUS)     &kp LG(PLUS)                      &kp LG(LA(LEFT_ARROW))  &kp LG(LA(DOWN_ARROW))  &kp LG(LA(UP_ARROW))  &kp LG(LA(RIGHT_ARROW))  &trans
&kp F12             &kp LG(L)  &trans            &kp LC(UP_ARROW)  &kp F3        &trans      &trans  &kp LEFT_ARROW          &kp DOWN_ARROW          &kp UP_ARROW          &kp RIGHT                &kp LA(LC(ENTER))
&trans              &trans     &trans            &trans            &trans        &trans      &trans  &kp LA(LC(LEFT_ARROW))  &kp LA(LC(DOWN_ARROW))  &kp LC(LA(UP_ARROW))  &kp LA(LC(RIGHT))        &trans
&trans              &trans     &trans            &kp LG(SPACE)     &trans        &trans      &trans  &none                                                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_DEC C_BRIGHTNESS_INC>;
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &mac_mode  &win_mode  &win_mode_2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &trans       &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &trans       &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };

        Win_default {
            bindings = <
&mt ESC Q         &kp W         &kp E         &kp R             &kp T                                          &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A             &kp S         &kp D         &kp F             &kp G        &kp LC(LS(S))      &kp SEMICOLON  &kp H        &kp J  &kp K      &kp L       &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &kp B        &trans             &kp SQT        &kp N        &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&kp LEFT_SHIFT    &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &lt 5 SPACE  &lt 3 TAB          &kp BACKSPACE  &lt 6 ENTER                                &kp LA(LEFT_ARROW)
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        layer_5 {
            bindings = <
&trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LEFT_PARENTHESIS                      &kp RIGHT_PARENTHESIS  &kp TILDE  &kp EXCLAMATION  &kp AT        &kp PIPE
&trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LEFT_BRACKET      &trans      &trans  &kp RIGHT_BRACKET      &kp HASH   &kp DOLLAR       &kp PERCENT   &kp EQUAL
&kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LEFT_BRACE        &trans      &trans  &kp RIGHT_BRACE        &kp CARET  &kp AMPERSAND    &kp ASTERISK  &kp PLUS
&trans           &trans           &trans           &trans           &trans                &trans      &trans  &trans                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &kp LC(MINUS)                &kp LC(PLUS)                                   &kp LA(LC(LEFT_ARROW))  &kp LA(LC(DOWN_ARROW))  &kp LA(LC(UP_ARROW))  &kp LC(LA(RIGHT_ARROW))  &trans
&trans  &trans  &trans  &kp LA(TAB)                  &trans              &trans             &trans  &kp LEFT_ARROW          &kp DOWN_ARROW          &kp UP_ARROW          &kp RIGHT_ARROW          &trans
&trans  &trans  &trans  &trans                       &trans              &trans             &trans  &trans                  &trans                  &trans                &trans                   &trans
&trans  &trans  &trans  &kp LA(LANG_ZENKAKUHANKAKU)  &kp LA(LANGUAGE_5)  &kp LA(LANG5)      &trans  &trans                                                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_DEC C_BRI_INC>;
        };
    };
};
